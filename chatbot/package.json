{
  "name": "whatsapp-web.js",
  "version": "1.32.0",
  "description": "Library for interacting with the WhatsApp Web API ",
  "main": "./index.js",
  "typings": "./index.d.ts",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"cd dashboard && npm run dev\"",
    "test": "mocha tests --recursive --timeout 5000",
    "test-single": "mocha",
    "shell": "node --experimental-repl-await ./shell.js",
    "generate-docs": "npx jsdoc --configure .jsdoc.json --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroslopez/whatsapp-web.js.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "api",
    "bot",
    "client",
    "node"
  ],
  "author": "Pedro Lopez",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pedroslopez/whatsapp-web.js/issues"
  },
  "homepage": "https://wwebjs.dev/",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pedroslopez/moduleraid": "^5.0.2",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fluent-ffmpeg": "2.1.3",
    "mime": "^3.0.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "node-webpmux": "3.1.7",
    "openai": "^5.15.0",
    "puppeteer": "^24.16.2",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "string-similarity": "^4.0.4",
    "transliteration": "^2.3.5",
    "whatsapp-web.js": "^1.34.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.5.12",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "dotenv": "^16.0.0",
    "eslint": "^8.4.1",
    "eslint-plugin-mocha": "^10.0.3",
    "jsdoc": "^3.6.4",
    "jsdoc-baseline": "^0.1.5",
    "mocha": "^11.7.1",
    "pkg": "^5.8.1",
    "sinon": "^13.0.1"
  },
